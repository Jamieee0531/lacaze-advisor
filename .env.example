# Inherits existing ANTHROPIC_* shell settings when present. Never commit a real key.
LACAZE_MODEL=claude-opus-4-8
# ANTHROPIC_BASE_URL=http://localhost:6655/anthropic
# ANTHROPIC_AUTH_TOKEN=your-local-token
# LACAZE_DATA_DIR=/absolute/path/to/lacaze-advisor/data
LACAZE_MAX_PRODUCT_QUERIES=2
LACAZE_REQUEST_TIMEOUT_SECONDS=180
