# Copy to .env and fill in. Never commit a real key.
# An API key comes from Claude Console (platform.claude.com), not from a Claude app plan.
ANTHROPIC_API_KEY=
LACAZE_MODEL=claude-sonnet-5-5
# Only when going through a proxy:
# ANTHROPIC_BASE_URL=http://localhost:6655/anthropic
# ANTHROPIC_AUTH_TOKEN=your-proxy-token
# LACAZE_DATA_DIR=/absolute/path/to/lacaze-advisor/data
LACAZE_REQUEST_TIMEOUT_SECONDS=180
# Hosting only:
# LACAZE_ACCESS_CODE=choose-a-code
# LACAZE_ALLOWED_HOSTS=demo.example.com
